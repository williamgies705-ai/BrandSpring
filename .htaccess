RewriteEngine On

# Use one canonical public address for SEO and analytics.
RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} !^www\.brandspring\.ca$ [NC]
RewriteRule ^ https://www.brandspring.ca%{REQUEST_URI} [R=301,L]


# Keep the hosted Stephany campaign project copy out of search indexes.
<IfModule mod_headers.c>
  SetEnvIf Request_URI "^/projects/stephanie4council(?:/|$)" noindex_stephany_project
  Header set X-Robots-Tag "noindex, nofollow, noarchive" env=noindex_stephany_project
</IfModule>
